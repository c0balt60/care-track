# Copy to `.env` and adjust if needed:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets; production values live in Vercel.
#
# Both Next.js and `docker compose` read `.env`.

# --- Logging (lib/logger.ts) ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=caretrack
POSTGRES_PASSWORD=caretrack
POSTGRES_DB=caretrack
# Change if something else on your machine already uses 5432.
POSTGRES_PORT=5432
# Must match the values above.
DATABASE_URL=postgres://caretrack:caretrack@localhost:5432/caretrack

# --- Mailpit (docker-compose.yml) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Planned: uncomment as each feature lands ---
# Better Auth (#11)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# Email in production (#26)
# RESEND_API_KEY=
# EMAIL_FROM=
# Stripe, test mode (#29, #30)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Reminder cron (#28)
# CRON_SECRET=
