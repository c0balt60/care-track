# Copy to `.env` and adjust if needed:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets; production values live in Vercel.
#
# Both Next.js and `docker compose` read `.env`.

# --- Logging (lib/logger.ts) ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=caretrack
POSTGRES_PASSWORD=caretrack
POSTGRES_DB=caretrack
# Change if something else on your machine already uses 5432.
POSTGRES_PORT=5432
# Must match the values above.
DATABASE_URL=postgres://caretrack:caretrack@localhost:5432/caretrack

# --- Mailpit (docker-compose.yml) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Better Auth (lib/better-auth.ts) ---
# Signs session cookies. This value is for LOCAL DEV ONLY: it's public in the repo, so
# anyone could forge a cookie with it. Production uses its own secret set in Vercel
# (generate one with: openssl rand -base64 32). Never put a real secret here.
BETTER_AUTH_SECRET=rdlmD3AA00bCYqe5t6ifLqkRY92n982Tjf4lHfmmpqE=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (lib/email.ts) ---
# Locally, email goes to Mailpit over SMTP (SMTP_HOST / SMTP_PORT above); read it at
# http://localhost:8025. In production set RESEND_API_KEY and email goes through Resend instead.
# EMAIL_FROM must be on a domain verified in Resend. Locally it defaults to a dummy address.
# RESEND_API_KEY=
# EMAIL_FROM="CareTrack <noreply@your-domain>"

# --- Stripe, test mode (lib/payments.ts) ---
# Booking needs this: the deposit goes through Stripe Checkout. Use a TEST key
# (sk_test_...) from https://dashboard.stripe.com/test/apikeys. Pay with card 4242 4242 4242 4242.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (whsec_...). Locally, `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints one; in production it's on the endpoint's Dashboard page.
STRIPE_WEBHOOK_SECRET=

# --- Planned: uncomment as each feature lands ---
# Reminder cron (#28)
# CRON_SECRET=
